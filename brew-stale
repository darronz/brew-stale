#!/usr/bin/env bash
# brew-stale
# Cross-references `brew leaves` and installed casks with shell history
# to find when each package was last used.
# Supports both bash and zsh history formats.
#
# Usage:
#   brew-stale              # default output sorted by last used (most recent first)
#   brew-stale --stale 30   # only show packages not used in the last 30 days
#   brew-stale --csv        # output as CSV for further processing
#   brew-stale --help       # show usage
#
# History format detection:
#   zsh timestamps  — : timestamp:duration;command
#   bash timestamps — #timestamp on the line before the command (when HISTTIMEFORMAT is set)
#   plain           — no timestamps, falls back to usage counts only

set -euo pipefail

# ─── Compatibility note ─────────────────────────────────────────────────────
# This script targets bash 3.2+ (the version shipped with macOS) so that it
# works out of the box without requiring `brew install bash`. Bash 3.2 lacks
# associative arrays (declare -A) and mapfile, so we use tab-delimited temp
# files with awk lookups instead of associative arrays, and a while-read loop
# instead of mapfile.

# ─── Temp storage for metadata (tab-delimited files, bash 3.2 compatible) ───
_TMPDIR=$(mktemp -d)
trap 'rm -rf "$_TMPDIR"' EXIT

# ─── Defaults ────────────────────────────────────────────────────────────────
STALE_DAYS=0
CSV_MODE=false

if [[ -n "${HISTFILE:-}" ]]; then
    HISTORY_FILE="$HISTFILE"
elif [[ -f "$HOME/.zsh_history" ]]; then
    HISTORY_FILE="$HOME/.zsh_history"
elif [[ -f "$HOME/.bash_history" ]]; then
    HISTORY_FILE="$HOME/.bash_history"
else
    HISTORY_FILE="$HOME/.bash_history"
fi

# ─── Colours (disabled if not a terminal) ────────────────────────────────────
# $'...' creates actual escape bytes — works with both echo and printf in bash 3.2
if [[ -t 1 ]]; then
    RED=$'\033[0;31m'
    YELLOW=$'\033[0;33m'
    GREEN=$'\033[0;32m'
    DIM=$'\033[2m'
    BOLD=$'\033[1m'
    RESET=$'\033[0m'
else
    RED='' YELLOW='' GREEN='' DIM='' BOLD='' RESET=''
fi

# ─── Helpers ─────────────────────────────────────────────────────────────────
PROGRESS_LINES=0
progress() {
    echo "${DIM}$*${RESET}" >&2
    (( PROGRESS_LINES++ )) || true
}

format_size() {
    local kb=$1
    if (( kb >= 1048576 )); then
        local whole=$(( kb / 1048576 ))
        local frac=$(( (kb % 1048576) * 10 / 1048576 ))
        printf "%d.%dG" "$whole" "$frac"
    elif (( kb >= 1024 )); then
        local whole=$(( kb / 1024 ))
        local frac=$(( (kb % 1024) * 10 / 1024 ))
        printf "%d.%dM" "$whole" "$frac"
    else
        printf "%dK" "$kb"
    fi
}

ts_to_date() {
    date -r "$1" "+%Y-%m-%d" 2>/dev/null || date -d "@$1" "+%Y-%m-%d" 2>/dev/null || echo "unknown"
}

# Look up a row by key (first column) in a tab-delimited file
_lookup() {
    awk -F'\t' -v k="$2" '$1 == k {print; exit}' "$1" 2>/dev/null
}

# ─── Usage ───────────────────────────────────────────────────────────────────
usage() {
    cat <<EOF
Usage: $(basename "$0") [OPTIONS]

Cross-references brew leaves and casks with shell history to show when each
package was last used. Supports both bash and zsh history formats.
Also detects brew services and uses macOS metadata for cask app last-used dates.

Options:
  --stale N    Only show packages not used in the last N days
  --csv        Output as CSV
  --history F  Path to history file (default: \$HISTFILE, ~/.zsh_history, or ~/.bash_history)
  --help       Show this help message
EOF
    exit 0
}

# ─── Parse arguments ─────────────────────────────────────────────────────────
while [[ $# -gt 0 ]]; do
    case "$1" in
        --stale)  STALE_DAYS="$2"; shift 2 ;;
        --csv)    CSV_MODE=true; shift ;;
        --history) HISTORY_FILE="$2"; shift 2 ;;
        --help)   usage ;;
        *)        echo "Unknown option: $1"; usage ;;
    esac
done

# ─── Validate ────────────────────────────────────────────────────────────────
if ! command -v brew &>/dev/null; then
    echo "Error: Homebrew is not installed." >&2
    exit 1
fi

if [[ ! -f "$HISTORY_FILE" ]]; then
    echo "Error: History file not found at $HISTORY_FILE" >&2
    exit 1
fi

# ─── Detect history format ──────────────────────────────────────────────────
HISTORY_FORMAT="plain"
if head -5 "$HISTORY_FILE" | grep -q '^: [0-9]' 2>/dev/null; then
    HISTORY_FORMAT="zsh"
elif head -5 "$HISTORY_FILE" | grep -q '^#[0-9]' 2>/dev/null; then
    HISTORY_FORMAT="bash"
fi

NOW=$(date +%s)

# ─── Detect brew services → services file (name\tstatus) ────────────────────
progress "Detecting brew services..."
brew services list 2>/dev/null \
    | awk 'NR>1 && $1 != "" {print $1 "\t" $2}' \
    > "$_TMPDIR/services" || true

# ─── Get formula packages ───────────────────────────────────────────────────
progress "Gathering brew leaves..."
packages=($(brew leaves))
progress "Found ${#packages[@]} formulae. Resolving details..."

# ─── Fetch formula info → formula_info file (name\tdesc\tinstall_ts) ────────
progress "Fetching formula info..."
if [[ ${#packages[@]} -gt 0 ]]; then
    brew info --json=v2 "${packages[@]}" 2>/dev/null \
        | python3 -c "
import sys, json
d = json.load(sys.stdin)
for f in d['formulae']:
    ts = 0
    if f.get('installed'):
        times = [i.get('time', 0) or 0 for i in f['installed']]
        ts = max(times) if times else 0
    print(f['full_name'] + '\t' + (f['desc'] or '') + '\t' + str(int(ts)))
" > "$_TMPDIR/formula_info" || true
fi

# ─── Get cask packages ──────────────────────────────────────────────────────
progress "Gathering casks..."
cask_list=($(brew list --cask 2>/dev/null || true))
progress "Found ${#cask_list[@]} casks."

# ─── Fetch cask info → cask_info file (token\tdesc\tinstall_ts\tapp_names) ──
if [[ ${#cask_list[@]} -gt 0 ]]; then
    progress "Fetching cask info..."
    brew info --json=v2 --cask "${cask_list[@]}" 2>/dev/null \
        | python3 -c "
import sys, json
d = json.load(sys.stdin)
for c in d.get('casks', []):
    apps = []
    for a in c.get('artifacts', []):
        if isinstance(a, dict) and 'app' in a:
            val = a['app']
            if isinstance(val, list):
                apps.extend(str(x) for x in val)
            else:
                apps.append(str(val))
    app_str = ','.join(apps)
    ts = c.get('installed_time', 0) or 0
    print(c['token'] + '\t' + (c.get('desc') or '') + '\t' + str(int(ts)) + '\t' + app_str)
" > "$_TMPDIR/cask_info" || true
fi

# ─── Process formulae (Cellar + history in one pass) ────────────────────────
progress "Scanning history..."

results=()

for pkg in "${packages[@]}"; do
    # Look up metadata from batch results
    _row=$(_lookup "$_TMPDIR/formula_info" "$pkg")
    IFS=$'\t' read -r _key desc json_ts <<< "$_row"
    desc="${desc:-}"
    json_ts="${json_ts:-0}"

    svc=$(awk -F'\t' -v k="$pkg" '$1 == k {print $2; exit}' "$_TMPDIR/services" 2>/dev/null)

    # ── Cellar: resolve aliases, size, install date ──
    aliases_str=""
    size_kb=0
    install_ts="$json_ts"

    cellar_dir="/opt/homebrew/Cellar/${pkg}"
    if [[ ! -d "$cellar_dir" ]]; then
        cellar_dir="/usr/local/Cellar/${pkg}"
    fi
    if [[ -d "$cellar_dir" ]]; then
        latest=$(ls -1 "$cellar_dir" 2>/dev/null | tail -1)
        if [[ -n "$latest" ]]; then
            size_kb=$(du -sk "$cellar_dir/$latest" 2>/dev/null | cut -f1)
            size_kb="${size_kb:-0}"

            if [[ "$install_ts" == "0" ]]; then
                install_ts=$(stat -f %B "$cellar_dir/$latest" 2>/dev/null || echo 0)
            fi

            if [[ -d "$cellar_dir/$latest/bin" ]]; then
                _aliases=()
                for binary in "$cellar_dir/$latest/bin/"*; do
                    bin_name=$(basename "$binary")
                    if [[ "$bin_name" != "$pkg" ]]; then
                        _aliases+=("$bin_name")
                    fi
                done
                if [[ ${#_aliases[@]} -gt 0 ]]; then
                    aliases_str=$(IFS=','; echo "${_aliases[*]}")
                fi
            fi
        fi
    fi

    # ── History search ──
    search_terms=("$pkg")
    if [[ -n "$aliases_str" ]]; then
        IFS=',' read -ra extra_terms <<< "$aliases_str"
        search_terms+=("${extra_terms[@]}")
    fi

    patterns=()
    for term in "${search_terms[@]}"; do
        escaped=$(printf '%s' "$term" | sed 's/[.[\*^$()+?{|]/\\&/g')
        patterns+=("$escaped")
    done
    grep_pattern=$(IFS='|'; echo "${patterns[*]}")

    matching_lines=$(grep -E "(;|^|\| *)($grep_pattern)( |$)" "$HISTORY_FILE" 2>/dev/null || true)

    if [[ -z "$matching_lines" ]]; then
        count=0
        last_ts=0
    else
        count=$(echo "$matching_lines" | wc -l | tr -d ' ')

        if [[ "$HISTORY_FORMAT" == "zsh" ]]; then
            last_ts=$(echo "$matching_lines" | sed -n 's/^: \([0-9]*\):.*/\1/p' | sort -nr | head -1)
            if [[ -z "$last_ts" ]]; then last_ts=0; fi
        elif [[ "$HISTORY_FORMAT" == "bash" ]]; then
            last_ts=$(grep -B1 -E "(;|^|\| *)($grep_pattern)( |$)" "$HISTORY_FILE" 2>/dev/null \
                | sed -n 's/^#\([0-9]*\)$/\1/p' | sort -nr | head -1)
            if [[ -z "$last_ts" ]]; then last_ts=0; fi
        else
            last_ts=0
        fi
    fi

    # ── Display values ──
    if (( last_ts > 0 )); then
        days_ago=$(( (NOW - last_ts) / 86400 ))
        date_str=$(ts_to_date "$last_ts")
        sort_key=$last_ts
    elif (( count > 0 )); then
        days_ago=-1
        date_str="no timestamp"
        sort_key=1
    else
        days_ago=-1
        date_str="never"
        sort_key=0
    fi

    if (( STALE_DAYS > 0 )); then
        if (( days_ago >= 0 && days_ago < STALE_DAYS )); then
            continue
        fi
    fi

    if (( install_ts > 0 )); then
        install_str=$(ts_to_date "$install_ts")
    else
        install_str="unknown"
    fi

    if (( size_kb > 0 )); then
        size_str=$(format_size "$size_kb")
    else
        size_str="—"
    fi

    results+=("${sort_key}|${pkg}|formula|${install_str}|${date_str}|${days_ago}|${count}|${size_str}|${svc:-}|${aliases_str}|${desc}")
done

# ─── Process casks (macOS metadata + history) ───────────────────────────────
for cask in "${cask_list[@]}"; do
    _row=$(_lookup "$_TMPDIR/cask_info" "$cask")
    IFS=$'\t' read -r _key desc install_ts app_names <<< "$_row"
    desc="${desc:-}"
    install_ts="${install_ts:-0}"
    app_names="${app_names:-}"

    svc=$(awk -F'\t' -v k="$cask" '$1 == k {print $2; exit}' "$_TMPDIR/services" 2>/dev/null)

    last_ts=0
    total_size_kb=0

    # Check .app bundles for last-used date (Spotlight metadata) and size
    if [[ -n "$app_names" ]]; then
        IFS=',' read -ra apps <<< "$app_names"
        for app in "${apps[@]}"; do
            for app_dir in "/Applications" "$HOME/Applications"; do
                app_path="${app_dir}/${app}"
                if [[ -d "$app_path" ]]; then
                    mdls_val=$(mdls -raw -name kMDItemLastUsedDate "$app_path" 2>/dev/null || true)
                    if [[ -n "$mdls_val" && "$mdls_val" != "(null)" ]]; then
                        mdls_ts=$(date -jf "%Y-%m-%d %H:%M:%S %z" "$mdls_val" "+%s" 2>/dev/null || true)
                        if [[ -n "$mdls_ts" ]] && (( mdls_ts > last_ts )); then
                            last_ts=$mdls_ts
                        fi
                    fi

                    app_kb=$(du -sk "$app_path" 2>/dev/null | cut -f1)
                    (( total_size_kb += app_kb )) || true
                    break
                fi
            done
        done
    fi

    # Fallback size from Caskroom
    if (( total_size_kb == 0 )); then
        caskroom="/opt/homebrew/Caskroom/${cask}"
        [[ ! -d "$caskroom" ]] && caskroom="/usr/local/Caskroom/${cask}"
        if [[ -d "$caskroom" ]]; then
            total_size_kb=$(du -sk "$caskroom" 2>/dev/null | cut -f1)
        fi
    fi

    # History search
    search_terms=("$cask")
    if [[ -n "$app_names" ]]; then
        IFS=',' read -ra apps <<< "$app_names"
        for app in "${apps[@]}"; do
            search_terms+=("${app%.app}")
        done
    fi

    patterns=()
    for term in "${search_terms[@]}"; do
        escaped=$(printf '%s' "$term" | sed 's/[.[\*^$()+?{|]/\\&/g')
        patterns+=("$escaped")
    done
    grep_pattern=$(IFS='|'; echo "${patterns[*]}")

    matching_lines=$(grep -iE "(;|^|\| *)(open -a *|)($grep_pattern)( |$)" "$HISTORY_FILE" 2>/dev/null || true)

    if [[ -z "$matching_lines" ]]; then
        count=0
    else
        count=$(echo "$matching_lines" | wc -l | tr -d ' ')

        if (( last_ts == 0 )); then
            if [[ "$HISTORY_FORMAT" == "zsh" ]]; then
                hist_ts=$(echo "$matching_lines" | sed -n 's/^: \([0-9]*\):.*/\1/p' | sort -nr | head -1)
                if [[ -n "$hist_ts" ]]; then last_ts=$hist_ts; fi
            elif [[ "$HISTORY_FORMAT" == "bash" ]]; then
                hist_ts=$(grep -B1 -iE "(;|^|\| *)(open -a *|)($grep_pattern)( |$)" "$HISTORY_FILE" 2>/dev/null \
                    | sed -n 's/^#\([0-9]*\)$/\1/p' | sort -nr | head -1)
                if [[ -n "$hist_ts" ]]; then last_ts=$hist_ts; fi
            fi
        fi
    fi

    if (( last_ts > 0 )); then
        days_ago=$(( (NOW - last_ts) / 86400 ))
        date_str=$(ts_to_date "$last_ts")
        sort_key=$last_ts
    elif (( count > 0 )); then
        days_ago=-1
        date_str="no timestamp"
        sort_key=1
    else
        days_ago=-1
        date_str="never"
        sort_key=0
    fi

    if (( STALE_DAYS > 0 )); then
        if (( days_ago >= 0 && days_ago < STALE_DAYS )); then
            continue
        fi
    fi

    # Install date with Caskroom filesystem fallback
    if (( install_ts > 0 )); then
        install_str=$(ts_to_date "$install_ts")
    else
        caskroom="/opt/homebrew/Caskroom/${cask}"
        [[ ! -d "$caskroom" ]] && caskroom="/usr/local/Caskroom/${cask}"
        if [[ -d "$caskroom" ]]; then
            fs_ts=$(stat -f %B "$caskroom" 2>/dev/null || echo 0)
            if (( fs_ts > 0 )); then
                install_str=$(ts_to_date "$fs_ts")
            else
                install_str="unknown"
            fi
        else
            install_str="unknown"
        fi
    fi

    if (( total_size_kb > 0 )); then
        size_str=$(format_size "$total_size_kb")
    else
        size_str="—"
    fi

    alias_str=""
    if [[ -n "$app_names" ]]; then
        alias_str="${app_names//.app/}"
    fi

    results+=("${sort_key}|${cask}|cask|${install_str}|${date_str}|${days_ago}|${count}|${size_str}|${svc:-}|${alias_str}|${desc}")
done

# ─── Sort ────────────────────────────────────────────────────────────────────
sorted=()
while IFS= read -r line; do
    sorted+=("$line")
done < <(printf '%s\n' "${results[@]}" | sort -t'|' -k1 -nr)

if [[ ${#sorted[@]} -eq 0 ]]; then
    echo "No packages found."
    exit 0
fi

# ─── Output ──────────────────────────────────────────────────────────────────
if [[ "$CSV_MODE" == true ]]; then
    echo "package,type,description,installed_date,last_used_date,days_ago,times_used,size,service_status,binary_aliases"
    for entry in "${sorted[@]}"; do
        IFS='|' read -r _ pkg type install_str date_str days count size_str service_str bin_aliases desc <<< "$entry"
        if (( days == -1 )); then days=""; fi
        echo "${pkg},${type},${desc},${install_str},${date_str},${days},${count},${size_str},${service_str},${bin_aliases}"
    done
else
    # Clear progress messages
    for (( i = 0; i < PROGRESS_LINES; i++ )); do
        printf "\033[A\033[2K" >&2
    done
    printf "\r" >&2

    # Header
    printf "${BOLD}%-25s %-8s %-12s %-14s %-10s %-8s %-8s %-40s %s${RESET}\n" \
        "PACKAGE" "TYPE" "INSTALLED" "LAST USED" "DAYS AGO" "USES" "SIZE" "DESCRIPTION" "ALIASES"
    printf "${DIM}%-25s %-8s %-12s %-14s %-10s %-8s %-8s %-40s %s${RESET}\n" \
        "-------" "----" "---------" "---------" "--------" "----" "----" "-----------" "-------"

    for entry in "${sorted[@]}"; do
        IFS='|' read -r _ pkg type install_str date_str days count size_str service_str bin_aliases desc <<< "$entry"

        # Colour coding
        if [[ "$date_str" == "never" ]]; then
            colour="$RED"
            days_display="—"
        elif (( days == -1 )); then
            colour="$YELLOW"
            days_display="?"
        elif (( days > 90 )); then
            colour="$RED"
            days_display="${days}d"
        elif (( days > 30 )); then
            colour="$YELLOW"
            days_display="${days}d"
        else
            colour="$GREEN"
            days_display="${days}d"
        fi

        # Active services are in use even without shell history
        if [[ "$service_str" == "started" && "$date_str" == "never" ]]; then
            colour="$GREEN"
        fi

        # Truncate long descriptions
        if (( ${#desc} > 38 )); then
            desc="${desc:0:37}…"
        fi

        # Build trailing info: aliases + service indicator
        trailing=""
        if [[ -n "$bin_aliases" ]]; then
            trailing="${DIM}(${bin_aliases})${RESET}"
        fi
        if [[ "$service_str" == "started" ]]; then
            trailing+=" ${GREEN}● service${RESET}"
        elif [[ -n "$service_str" && "$service_str" != "none" ]]; then
            trailing+=" ${DIM}○ service (${service_str})${RESET}"
        fi

        printf "${colour}%-25s %-8s %-12s %-14s %-10s %-8s${RESET} %-8s %-40s %b\n" \
            "$pkg" "$type" "$install_str" "$date_str" "$days_display" "$count" "$size_str" "$desc" "$trailing"
    done

    # Summary
    total=${#sorted[@]}
    never=0
    stale_90=0
    total_formulae=0
    total_casks=0
    total_services=0
    for entry in "${sorted[@]}"; do
        IFS='|' read -r _ _ type _ date_str days _ _ service_str _ _ <<< "$entry"
        if [[ "$date_str" == "never" && "$service_str" != "started" ]]; then (( never++ )) || true; fi
        if (( days > 90 )); then (( stale_90++ )) || true; fi
        if [[ "$type" == "formula" ]]; then (( total_formulae++ )) || true; fi
        if [[ "$type" == "cask" ]]; then (( total_casks++ )) || true; fi
        if [[ "$service_str" == "started" ]]; then (( total_services++ )) || true; fi
    done

    echo ""
    printf "${DIM}Total: %d packages (%d formulae, %d casks) | ${GREEN}Services: %d${RESET}${DIM} | ${RED}Never used: %d${RESET}${DIM} | ${YELLOW}Stale (>90d): %d${RESET}\n" \
        "$total" "$total_formulae" "$total_casks" "$total_services" "$never" "$stale_90"

    if (( never + stale_90 > 0 )); then
        echo ""
        echo "${DIM}Tip: Uninstall candidates with:  brew uninstall <package> && brew autoremove${RESET}"
    fi
fi
