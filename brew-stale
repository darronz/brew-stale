#!/bin/zsh
# brew-stale
# Cross-references `brew leaves` with zsh history to find when each tool was last used.
#
# Usage:
#   brew-stale              # default output sorted by last used (most recent first)
#   brew-stale --stale 30   # only show packages not used in the last 30 days
#   brew-stale --csv        # output as CSV for further processing
#   brew-stale --help       # show usage
#
# Note: If your zsh history includes timestamps (: timestamp:duration;command format),
#       the script will show last-used dates. Otherwise it falls back to usage counts only.

set -euo pipefail

# ─── Defaults ────────────────────────────────────────────────────────────────
STALE_DAYS=0
CSV_MODE=false
HISTORY_FILE="${HISTFILE:-$HOME/.zsh_history}"

# ─── Colours (disabled if not a terminal) ────────────────────────────────────
if [[ -t 1 ]]; then
    RED='\033[0;31m'
    YELLOW='\033[0;33m'
    GREEN='\033[0;32m'
    DIM='\033[2m'
    BOLD='\033[1m'
    RESET='\033[0m'
else
    RED='' YELLOW='' GREEN='' DIM='' BOLD='' RESET=''
fi

# ─── Usage ───────────────────────────────────────────────────────────────────
usage() {
    cat <<EOF
Usage: $(basename "$0") [OPTIONS]

Cross-references brew leaves with zsh history to show when each tool was last used.

Options:
  --stale N    Only show packages not used in the last N days
  --csv        Output as CSV (package,last_used_date,days_ago,times_used)
  --history F  Path to zsh history file (default: \$HISTFILE or ~/.zsh_history)
  --help       Show this help message
EOF
    exit 0
}

# ─── Parse arguments ─────────────────────────────────────────────────────────
while [[ $# -gt 0 ]]; do
    case "$1" in
        --stale)  STALE_DAYS="$2"; shift 2 ;;
        --csv)    CSV_MODE=true; shift ;;
        --history) HISTORY_FILE="$2"; shift 2 ;;
        --help)   usage ;;
        *)        echo "Unknown option: $1"; usage ;;
    esac
done

# ─── Validate ────────────────────────────────────────────────────────────────
if ! command -v brew &>/dev/null; then
    echo "Error: Homebrew is not installed." >&2
    exit 1
fi

if [[ ! -f "$HISTORY_FILE" ]]; then
    echo "Error: History file not found at $HISTORY_FILE" >&2
    exit 1
fi

# ─── Check if history has timestamps ─────────────────────────────────────────
HAS_TIMESTAMPS=false
if head -5 "$HISTORY_FILE" | grep -q '^: [0-9]' 2>/dev/null; then
    HAS_TIMESTAMPS=true
fi

# ─── Get installed packages ─────────────────────────────────────────────────
echo "${DIM}Gathering brew leaves...${RESET}" >&2
packages=($(brew leaves))

if [[ ${#packages[@]} -eq 0 ]]; then
    echo "No packages found from brew leaves."
    exit 0
fi

echo "${DIM}Found ${#packages[@]} packages. Resolving binary names...${RESET}" >&2

# ─── Fetch package descriptions ────────────────────────────────────────────
echo "${DIM}Fetching package descriptions...${RESET}" >&2
typeset -A pkg_descs
while IFS='|' read -r name desc; do
    pkg_descs[$name]="$desc"
done < <(brew info --json=v2 "${packages[@]}" 2>/dev/null \
    | python3 -c "import sys,json; d=json.load(sys.stdin); [print(f['full_name']+'|'+(f['desc'] or '')) for f in d['formulae']]")

# ─── Resolve binary aliases ─────────────────────────────────────────────────
# Some packages install binaries with different names (e.g. "ripgrep" -> "rg").
typeset -A pkg_aliases  # pkg -> comma-separated alias list

for pkg in "${packages[@]}"; do
    cellar_bin="/opt/homebrew/Cellar/${pkg}"
    if [[ ! -d "$cellar_bin" ]]; then
        cellar_bin="/usr/local/Cellar/${pkg}"
    fi
    if [[ -d "$cellar_bin" ]]; then
        latest=$(ls -1 "$cellar_bin" 2>/dev/null | tail -1)
        if [[ -n "$latest" && -d "$cellar_bin/$latest/bin" ]]; then
            bin_aliases=()
            for binary in "$cellar_bin/$latest/bin/"*; do
                bin_name=$(basename "$binary")
                if [[ "$bin_name" != "$pkg" ]]; then
                    bin_aliases+=("$bin_name")
                fi
            done
            if [[ ${#bin_aliases[@]} -gt 0 ]]; then
                pkg_aliases[$pkg]=$(IFS=','; echo "${bin_aliases[*]}")
            fi
        fi
    fi
done

# ─── Search history using grep (fast) ───────────────────────────────────────
echo "${DIM}Scanning history...${RESET}" >&2
NOW=$(date +%s)

typeset -a results

for pkg in "${packages[@]}"; do
    # Build list of search terms: the package name + any binary aliases
    search_terms=("$pkg")
    if [[ -n "${pkg_aliases[$pkg]:-}" ]]; then
        IFS=',' read -rA extra_terms <<< "${pkg_aliases[$pkg]}"
        search_terms+=("${extra_terms[@]}")
    fi

    # Build a grep pattern that matches any term as the invoked command.
    # Matches after ; (timestamped history), at start of line, or after a pipe.
    patterns=()
    for term in "${search_terms[@]}"; do
        escaped=$(printf '%s' "$term" | sed 's/[.[\*^$()+?{|]/\\&/g')
        patterns+=("$escaped")
    done
    grep_pattern=$(IFS='|'; echo "${patterns[*]}")

    # Use grep for the heavy lifting — orders of magnitude faster than zsh loops
    matching_lines=$(grep -E "(;|^|\| *)($grep_pattern)( |$)" "$HISTORY_FILE" 2>/dev/null || true)

    if [[ -z "$matching_lines" ]]; then
        count=0
        last_ts=0
    else
        count=$(echo "$matching_lines" | wc -l | tr -d ' ')

        if [[ "$HAS_TIMESTAMPS" == true ]]; then
            # Extract timestamps and get the most recent one
            # macOS sed is BSD — use compatible syntax
            last_ts=$(echo "$matching_lines" | sed -n 's/^: \([0-9]*\):.*/\1/p' | sort -nr | head -1)
            if [[ -z "$last_ts" ]]; then last_ts=0; fi
        else
            last_ts=0
        fi
    fi

    # Compute display values
    if (( last_ts > 0 )); then
        days_ago=$(( (NOW - last_ts) / 86400 ))
        date_str=$(date -r "$last_ts" "+%Y-%m-%d" 2>/dev/null || date -d "@$last_ts" "+%Y-%m-%d" 2>/dev/null || echo "unknown")
        sort_key=$last_ts
    elif (( count > 0 )); then
        days_ago=-1
        date_str="no timestamp"
        sort_key=1
    else
        days_ago=-1
        date_str="never"
        sort_key=0
    fi

    # Apply stale filter
    if (( STALE_DAYS > 0 )); then
        if (( days_ago >= 0 && days_ago < STALE_DAYS )); then
            continue
        fi
    fi

    alias_str="${pkg_aliases[$pkg]:-}"
    desc_str="${pkg_descs[$pkg]:-}"
    results+=("${sort_key}|${pkg}|${date_str}|${days_ago}|${count}|${alias_str}|${desc_str}")
done

# Sort by timestamp descending (most recently used first), never-used at the bottom
sorted=("${(@f)$(printf '%s\n' "${results[@]}" | sort -t'|' -k1 -nr)}")

# ─── Output ──────────────────────────────────────────────────────────────────
if [[ "$CSV_MODE" == true ]]; then
    echo "package,description,last_used_date,days_ago,times_used,binary_aliases"
    for entry in "${sorted[@]}"; do
        IFS='|' read -r _ pkg date_str days count bin_aliases desc <<< "$entry"
        if (( days == -1 )); then days=""; fi
        echo "${pkg},${desc},${date_str},${days},${count},${bin_aliases}"
    done
else
    # Clear progress messages
    printf "\033[2K\033[A\033[2K\033[A\033[2K\033[A\033[2K\033[A\r" >&2

    # Header
    printf "${BOLD}%-25s %-14s %-10s %-8s %-40s %s${RESET}\n" "PACKAGE" "LAST USED" "DAYS AGO" "USES" "DESCRIPTION" "ALIASES"
    printf "${DIM}%-25s %-14s %-10s %-8s %-40s %s${RESET}\n" "───────" "─────────" "────────" "────" "───────────" "───────"

    for entry in "${sorted[@]}"; do
        IFS='|' read -r _ pkg date_str days count bin_aliases desc <<< "$entry"

        # Colour coding
        if [[ "$date_str" == "never" ]]; then
            colour="$RED"
            days_display="—"
        elif (( days == -1 )); then
            colour="$YELLOW"
            days_display="?"
        elif (( days > 90 )); then
            colour="$RED"
            days_display="${days}d"
        elif (( days > 30 )); then
            colour="$YELLOW"
            days_display="${days}d"
        else
            colour="$GREEN"
            days_display="${days}d"
        fi

        # Truncate long descriptions
        if (( ${#desc} > 38 )); then
            desc="${desc:0:37}…"
        fi

        alias_display=""
        if [[ -n "$bin_aliases" ]]; then
            alias_display="${DIM}(${bin_aliases})${RESET}"
        fi

        printf "${colour}%-25s %-14s %-10s %-8s${RESET} %-40s %b\n" \
            "$pkg" "$date_str" "$days_display" "$count" "$desc" "$alias_display"
    done

    # Summary
    total=${#sorted[@]}
    never=0
    stale_90=0
    for entry in "${sorted[@]}"; do
        IFS='|' read -r _ _ date_str days _ _ _ <<< "$entry"
        if [[ "$date_str" == "never" ]]; then (( never++ )) || true; fi
        if (( days > 90 )); then (( stale_90++ )) || true; fi
    done

    echo ""
    printf "${DIM}Total: %d packages | ${RED}Never used: %d${RESET}${DIM} | ${YELLOW}Stale (>90d): %d${RESET}\n" \
        "$total" "$never" "$stale_90"

    if (( never + stale_90 > 0 )); then
        echo ""
        echo "${DIM}Tip: Uninstall candidates with:  brew uninstall <package> && brew autoremove${RESET}"
    fi
fi
